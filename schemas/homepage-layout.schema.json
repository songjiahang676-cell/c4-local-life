{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.socal.local/homepage-layout.schema.json",
  "title": "Homepage operational layout",
  "type": "object",
  "required": ["version", "locale", "regionCode", "slots"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "locale": {
      "enum": ["zh-Hans", "en-US"]
    },
    "regionCode": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "slots": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "HERO" },
                  "source": { "$ref": "#/$defs/heroSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "HOT_SEARCHES" },
                  "source": { "$ref": "#/$defs/hotSearchesSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "CITY_CHIPS" },
                  "source": { "$ref": "#/$defs/cityChipsSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "LISTING_FEED" },
                  "source": { "$ref": "#/$defs/listingFeedSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "BUSINESS_CAROUSEL" },
                  "source": { "$ref": "#/$defs/verifiedCollectionSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "PROVIDER_CAROUSEL" },
                  "source": { "$ref": "#/$defs/verifiedCollectionSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "AD" },
                  "source": { "$ref": "#/$defs/adSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "PRICE_METRIC" },
                  "source": { "$ref": "#/$defs/priceMetricSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "RESOURCE_PRODUCTS" },
                  "source": { "$ref": "#/$defs/resourceProductsSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          },
          {
            "allOf": [
              { "$ref": "#/$defs/slotBase" },
              {
                "type": "object",
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "PORTAL_LINKS" },
                  "source": { "$ref": "#/$defs/portalLinksSource" }
                }
              }
            ],
            "unevaluatedProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "configurationKey": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "slotBase": {
      "type": "object",
      "required": ["key", "enabled", "limit"],
      "properties": {
        "key": { "$ref": "#/$defs/configurationKey" },
        "enabled": { "type": "boolean" },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "sponsoredDisclosure": {
          "type": "boolean",
          "default": false
        },
        "cacheTtlSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400,
          "default": 300
        }
      }
    },
    "heroSource": {
      "type": "object",
      "required": ["contentKey"],
      "properties": {
        "contentKey": { "$ref": "#/$defs/configurationKey" },
        "imageAssetKey": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "pattern": "^[a-z0-9][a-z0-9/_-]*[a-z0-9]$"
        }
      },
      "additionalProperties": false
    },
    "hotSearchesSource": {
      "type": "object",
      "required": ["window"],
      "properties": {
        "window": { "enum": ["DAY_1", "DAY_7", "DAY_30"] },
        "regionScoped": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "cityChipsSource": {
      "type": "object",
      "required": ["regionType"],
      "properties": {
        "regionType": { "const": "CITY" }
      },
      "additionalProperties": false
    },
    "listingFeedSource": {
      "type": "object",
      "required": ["listingType"],
      "properties": {
        "listingType": {
          "enum": ["JOB", "RENTAL", "TRANSFER", "SECONDHAND", "SERVICE"]
        },
        "sort": {
          "enum": ["NEWEST", "PRICE_ASC", "PRICE_DESC"],
          "default": "NEWEST"
        },
        "categoryId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "verifiedCollectionSource": {
      "type": "object",
      "required": ["verifiedOnly"],
      "properties": {
        "verifiedOnly": { "const": true },
        "categoryId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    },
    "adSource": {
      "type": "object",
      "required": ["placementKey"],
      "properties": {
        "placementKey": { "$ref": "#/$defs/configurationKey" }
      },
      "additionalProperties": false
    },
    "priceMetricSource": {
      "type": "object",
      "required": ["metricKeys"],
      "properties": {
        "metricKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": ["RENTAL_MEDIAN", "WAGE_MEDIAN", "SERVICE_PRICE_MEDIAN"]
          }
        }
      },
      "additionalProperties": false
    },
    "resourceProductsSource": {
      "type": "object",
      "required": ["collectionKey"],
      "properties": {
        "collectionKey": { "$ref": "#/$defs/configurationKey" }
      },
      "additionalProperties": false
    },
    "portalLinksSource": {
      "type": "object",
      "required": ["audience"],
      "properties": {
        "audience": {
          "enum": ["PUBLIC", "AUTHENTICATED", "ROLE_SCOPED"]
        }
      },
      "additionalProperties": false
    }
  }
}
