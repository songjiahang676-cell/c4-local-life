C4Container
  title 南加生活网 — Container Architecture
  Person(user, "用户")
  Person(operator, "运营人员")
  System_Boundary(platform, "南加生活网") {
    Container(web, "Public Web", "Next.js", "SSR/ISR、SEO、响应式前台")
    Container(admin, "Admin Web", "Next.js", "运营、审核、客服、广告和财务后台")
    Container(api, "API", "NestJS + Fastify", "模块化单体、REST、鉴权和业务事务")
    Container(worker, "Workers", "Node.js + BullMQ", "索引、媒体、通知、过期、对账任务")
    ContainerDb(db, "Primary DB", "PostgreSQL + PostGIS", "交易数据、地理数据、审计和 outbox")
    ContainerDb(search, "Search", "OpenSearch", "中文/英文全文、筛选、地理和排序")
    ContainerDb(cache, "Cache/Queue", "Redis", "缓存、限流、队列、分布式锁")
    ContainerDb(media, "Object Storage", "S3", "原图、衍生图、文档和广告素材")
    Container(obs, "Observability", "OpenTelemetry", "日志、指标、追踪和告警")
  }
  System_Ext(stripe, "Stripe", "支付")
  System_Ext(comms, "Email/SMS", "通知")

  Rel(user, web, "HTTPS")
  Rel(operator, admin, "HTTPS")
  Rel(web, api, "REST/JSON", "private network or signed origin")
  Rel(admin, api, "REST/JSON", "MFA + RBAC")
  Rel(api, db, "SQL")
  Rel(api, cache, "RESP")
  Rel(api, media, "S3 API")
  Rel(worker, db, "SQL + outbox")
  Rel(worker, cache, "BullMQ")
  Rel(worker, search, "Index API")
  Rel(worker, media, "S3 API")
  Rel(api, stripe, "HTTPS")
  Rel(stripe, api, "Signed webhook")
  Rel(worker, comms, "HTTPS/SMTP")
  Rel(api, obs, "OTLP")
  Rel(worker, obs, "OTLP")
