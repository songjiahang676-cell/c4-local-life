{
  "name": "@socal/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @socal/config build && pnpm --filter @socal/observability build",
    "dev": "tsx --env-file=../../.env watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --project @socal/api --reporter=default"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@socal/config": "workspace:*",
    "@socal/contracts": "workspace:*",
    "@socal/observability": "workspace:*",
    "fastify": "5.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "typescript-eslint": "8.57.0"
  }
}
