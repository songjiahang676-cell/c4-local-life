{
  "name": "@socal/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "auth-session": [
        "src/repositories/auth-session.repository.ts"
      ],
      "otp-challenge": [
        "src/repositories/otp-challenge.repository.ts"
      ],
      "organization": [
        "src/repositories/organization.repository.ts"
      ]
    }
  },
  "exports": {
    ".": "./src/index.ts",
    "./auth-session": {
      "types": "./src/repositories/auth-session.repository.ts",
      "require": "./dist/src/repositories/auth-session.repository.js",
      "default": "./dist/src/repositories/auth-session.repository.js"
    },
    "./otp-challenge": {
      "types": "./src/repositories/otp-challenge.repository.ts",
      "require": "./dist/src/repositories/otp-challenge.repository.js",
      "default": "./dist/src/repositories/otp-challenge.repository.js"
    },
    "./organization": {
      "types": "./src/repositories/organization.repository.ts",
      "require": "./dist/src/repositories/organization.repository.js",
      "default": "./dist/src/repositories/organization.repository.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-runtime-package.cjs",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "seed:validate": "tsx src/seed/validate-seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run --config ../../vitest.config.ts --project @socal/database --reporter=default"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "dotenv": "17.2.3",
    "pg": "8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "24.10.9",
    "@types/pg": "8.15.6",
    "prisma": "7.9.0",
    "typescript": "catalog:"
  }
}
