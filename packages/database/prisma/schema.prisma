generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  LIMITED
  SUSPENDED
  DELETED
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  SIGN_IN
  VERIFY_CONTACT
  SENSITIVE_ACTION
}

enum OrganizationType {
  MERCHANT
  SERVICE_PROVIDER
  SUPPLIER
  MEDIA
  INTERNAL
}

enum MembershipRole {
  OWNER
  ADMIN
  EDITOR
  BILLING
  ANALYST
}

enum PlatformRole {
  SUPPORT
  MODERATOR
  SENIOR_MODERATOR
  AD_OPS
  FINANCE
  TAXONOMY_ADMIN
  PLATFORM_ADMIN
  READ_ONLY_AUDITOR
}

enum AuthenticationStrength {
  PRIMARY
  MFA
}

enum MfaCredentialStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum PasswordAuthAttemptOutcome {
  PENDING
  SUCCESS
  FAILURE
}

enum RegionType {
  COUNTRY
  STATE
  COUNTY
  CITY
  NEIGHBORHOOD
  ZIP_CODE
  REGION_GROUP
}

enum ListingType {
  JOB
  RENTAL
  TRANSFER
  SECONDHAND
  SERVICE
}

enum ContentStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  EXPIRED
  ARCHIVED
  SUSPENDED
  DELETED
}

enum ModerationStatus {
  NOT_REVIEWED
  AUTO_APPROVED
  PENDING_REVIEW
  APPROVED
  REJECTED
  ESCALATED
}

enum PriceUnit {
  FIXED
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  SQFT
  NEGOTIABLE
  FREE
}

enum ContactMode {
  IN_APP
  PHONE_REVEAL
  EMAIL_REVEAL
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaStatus {
  UPLOADING
  SCANNING
  READY
  REJECTED
  DELETED
}

enum MediaPurpose {
  LISTING_MEDIA
  AVATAR
  BUSINESS_LOGO
  AD_CREATIVE
  VERIFICATION
}

enum ConversationStatus {
  ACTIVE
  BLOCKED
  CLOSED
}

enum MessageKind {
  TEXT
  IMAGE
  SYSTEM
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  DELETED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReportStatus {
  OPEN
  TRIAGED
  ACTIONED
  DISMISSED
  CLOSED
}

enum ModerationCaseStatus {
  OPEN
  ASSIGNED
  RESOLVED
  APPEALED
  CLOSED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
  CANCELLED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  REQUIRES_PAYMENT
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum WalletEntryType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
  EXPIRE
  ADJUSTMENT
}

enum CampaignStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
  CANCELLED
}

enum CreativeStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

model User {
  id                      String                    @id @default(uuid()) @db.Uuid
  email                   String?                   @unique @db.VarChar(320)
  phoneE164               String?                   @unique @map("phone_e164") @db.VarChar(32)
  passwordHash            String?                   @map("password_hash") @db.VarChar(255)
  passwordChangedAt       DateTime?                 @map("password_changed_at") @db.Timestamptz(6)
  passwordFailedAttempts  Int                       @default(0) @map("password_failed_attempts")
  passwordLockedUntil     DateTime?                 @map("password_locked_until") @db.Timestamptz(6)
  status                  UserStatus                @default(ACTIVE)
  trustScore              Int                       @default(0) @map("trust_score")
  lastLoginAt             DateTime?                 @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  profile                 UserProfile?
  providerProfile         ProviderProfile?
  identities              Identity[]
  sessions                AuthSession[]
  otpChallenges           OtpChallenge[]
  memberships             OrganizationMembership[]
  listings                Listing[]
  favorites               Favorite[]
  participants            ConversationParticipant[]
  messages                Message[]                 @relation("MessageSender")
  reviews                 Review[]                  @relation("ReviewAuthor")
  reports                 Report[]                  @relation("ReportReporter")
  assignedCases           ModerationCase[]          @relation("CaseAssignee")
  moderationActions       ModerationAction[]        @relation("ActionActor")
  notifications           Notification[]
  orders                  Order[]
  mediaAssets             MediaAsset[]
  auditLogs               AuditLog[]                @relation("AuditActor")
  platformRoles           PlatformRoleAssignment[]  @relation("PlatformRoleSubject")
  platformRoleGrants      PlatformRoleAssignment[]  @relation("PlatformRoleGranter")
  platformRoleRevocations PlatformRoleAssignment[]  @relation("PlatformRoleRevoker")
  mfaCredential           MfaCredential?
  passwordAuthAttempts    PasswordAuthAttempt[]
  passwordRecoveries      PasswordRecoveryRequest[]

  @@index([status, createdAt])
  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id") @db.Uuid
  displayName     String   @map("display_name") @db.VarChar(80)
  avatarUrl       String?  @map("avatar_url") @db.VarChar(1024)
  preferredLocale String   @default("zh-Hans") @map("preferred_locale") @db.VarChar(16)
  bio             String?  @db.VarChar(500)
  homeRegionId    String?  @map("home_region_id") @db.Uuid
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeRegion      Region?  @relation(fields: [homeRegionId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model Identity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(40)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  emailAtProvider String?  @map("email_at_provider") @db.VarChar(320)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("identities")
}

model AuthSession {
  id                     String                 @id @default(uuid()) @db.Uuid
  userId                 String                 @map("user_id") @db.Uuid
  tokenHash              String                 @unique @map("token_hash") @db.VarChar(128)
  userAgent              String?                @map("user_agent") @db.VarChar(512)
  ipHash                 String?                @map("ip_hash") @db.VarChar(128)
  authenticationStrength AuthenticationStrength @default(PRIMARY) @map("authentication_strength")
  mfaVerifiedAt          DateTime?              @map("mfa_verified_at") @db.Timestamptz(6)
  expiresAt              DateTime               @map("expires_at") @db.Timestamptz(6)
  idleExpiresAt          DateTime               @default(now()) @map("idle_expires_at") @db.Timestamptz(6)
  lastSeenAt             DateTime               @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt              DateTime?              @map("revoked_at") @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, idleExpiresAt])
  @@map("auth_sessions")
}

model MfaCredential {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String              @unique @map("user_id") @db.Uuid
  status              MfaCredentialStatus @default(PENDING)
  encryptedSecret     String              @map("encrypted_secret") @db.VarChar(512)
  keyVersion          Int                 @default(1) @map("key_version")
  enrollmentExpiresAt DateTime            @map("enrollment_expires_at") @db.Timestamptz(6)
  activatedAt         DateTime?           @map("activated_at") @db.Timestamptz(6)
  disabledAt          DateTime?           @map("disabled_at") @db.Timestamptz(6)
  lastUsedStep        BigInt?             @map("last_used_step")
  failedAttempts      Int                 @default(0) @map("failed_attempts")
  lockedUntil         DateTime?           @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes       MfaRecoveryCode[]

  @@index([status, enrollmentExpiresAt])
  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id           String        @id @default(uuid()) @db.Uuid
  credentialId String        @map("credential_id") @db.Uuid
  codeHash     String        @map("code_hash") @db.VarChar(128)
  consumedAt   DateTime?     @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  credential   MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, codeHash])
  @@index([credentialId, consumedAt])
  @@map("mfa_recovery_codes")
}

model PasswordAuthAttempt {
  id             String                     @id @default(uuid()) @db.Uuid
  userId         String?                    @map("user_id") @db.Uuid
  identifierHash String                     @map("identifier_hash") @db.VarChar(128)
  ipHash         String                     @map("ip_hash") @db.VarChar(128)
  deviceHash     String                     @map("device_hash") @db.VarChar(128)
  outcome        PasswordAuthAttemptOutcome @default(PENDING)
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt    DateTime?                  @map("completed_at") @db.Timestamptz(6)
  user           User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifierHash, createdAt(sort: Desc)])
  @@index([ipHash, createdAt(sort: Desc)])
  @@index([deviceHash, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("password_auth_attempts")
}

model PasswordRecoveryRequest {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @map("user_id") @db.Uuid
  channel         OtpChannel
  destinationHash String     @map("destination_hash") @db.VarChar(128)
  tokenHash       String     @unique @map("token_hash") @db.VarChar(128)
  ipHash          String     @map("ip_hash") @db.VarChar(128)
  deviceHash      String     @map("device_hash") @db.VarChar(128)
  availableAt     DateTime   @map("available_at") @db.Timestamptz(6)
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(6)
  failedAttempts  Int        @default(0) @map("failed_attempts")
  consumedAt      DateTime?  @map("consumed_at") @db.Timestamptz(6)
  supersededAt    DateTime?  @map("superseded_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destinationHash, createdAt(sort: Desc)])
  @@index([ipHash, createdAt(sort: Desc)])
  @@index([deviceHash, createdAt(sort: Desc)])
  @@index([userId, expiresAt])
  @@map("password_recovery_requests")
}

model OtpChallenge {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @map("user_id") @db.Uuid
  channel         OtpChannel
  destination     String     @db.VarChar(320)
  destinationHash String     @map("destination_hash") @db.VarChar(128)
  purpose         OtpPurpose
  locale          String     @default("zh-Hans") @db.VarChar(16)
  codeHash        String     @map("code_hash") @db.VarChar(128)
  ipHash          String     @map("ip_hash") @db.VarChar(128)
  deviceHash      String     @map("device_hash") @db.VarChar(128)
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime?  @map("consumed_at") @db.Timestamptz(6)
  failedAttempts  Int        @default(0) @map("failed_attempts")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([destinationHash, purpose, createdAt(sort: Desc)])
  @@index([ipHash, createdAt(sort: Desc)])
  @@index([deviceHash, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  type               OrganizationType
  legalName          String?                  @map("legal_name") @db.VarChar(200)
  displayName        String                   @map("display_name") @db.VarChar(120)
  slug               String                   @unique @db.VarChar(140)
  status             UserStatus               @default(ACTIVE)
  verificationStatus VerificationStatus       @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                @map("deleted_at") @db.Timestamptz(6)
  memberships        OrganizationMembership[]
  listings           Listing[]
  businessProfile    BusinessProfile?
  providerProfiles   ProviderProfile[]
  campaigns          AdCampaign[]
  orders             Order[]

  @@index([type, status])
  @@map("organizations")
}

model OrganizationMembership {
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  role           MembershipRole
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_memberships")
}

model PlatformRoleAssignment {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  role        PlatformRole
  scope       Json?
  reasonCode  String       @map("reason_code") @db.VarChar(80)
  grantedById String?      @map("granted_by_id") @db.Uuid
  revokedById String?      @map("revoked_by_id") @db.Uuid
  grantedAt   DateTime     @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt   DateTime?    @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime?    @map("revoked_at") @db.Timestamptz(6)
  subject     User         @relation("PlatformRoleSubject", fields: [userId], references: [id], onDelete: Restrict)
  grantedBy   User?        @relation("PlatformRoleGranter", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy   User?        @relation("PlatformRoleRevoker", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt, expiresAt])
  @@index([role, revokedAt, expiresAt])
  @@map("platform_role_assignments")
}

model Region {
  id               String            @id @default(uuid()) @db.Uuid
  parentId         String?           @map("parent_id") @db.Uuid
  type             RegionType
  code             String            @unique @db.VarChar(80)
  slug             String            @db.VarChar(120)
  nameZhHans       String            @map("name_zh_hans") @db.VarChar(120)
  nameEn           String            @map("name_en") @db.VarChar(120)
  timezone         String            @default("America/Los_Angeles") @db.VarChar(64)
  latitude         Decimal?          @db.Decimal(9, 6)
  longitude        Decimal?          @db.Decimal(9, 6)
  isActive         Boolean           @default(true) @map("is_active")
  sortOrder        Int               @default(0) @map("sort_order")
  parent           Region?           @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Region[]          @relation("RegionTree")
  aliases          RegionAlias[]
  userProfiles     UserProfile[]
  listings         Listing[]
  businessProfiles BusinessProfile[]
  providerProfiles ProviderProfile[]

  @@unique([parentId, slug])
  @@index([type, isActive, sortOrder])
  @@map("regions")
}

model RegionAlias {
  id              String @id @default(uuid()) @db.Uuid
  regionId        String @map("region_id") @db.Uuid
  locale          String @db.VarChar(16)
  value           String @db.VarChar(120)
  normalizedValue String @map("normalized_value") @db.VarChar(120)
  region          Region @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@unique([regionId, locale, normalizedValue])
  @@index([normalizedValue])
  @@map("region_aliases")
}

model Category {
  id                 String                      @id @default(uuid()) @db.Uuid
  parentId           String?                     @map("parent_id") @db.Uuid
  vertical           ListingType?
  slug               String                      @db.VarChar(120)
  nameZhHans         String                      @map("name_zh_hans") @db.VarChar(120)
  nameEn             String                      @map("name_en") @db.VarChar(120)
  description        String?                     @db.VarChar(500)
  iconKey            String?                     @map("icon_key") @db.VarChar(80)
  formSchemaVersion  Int                         @default(1) @map("form_schema_version")
  isActive           Boolean                     @default(true) @map("is_active")
  sortOrder          Int                         @default(0) @map("sort_order")
  parent             Category?                   @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]                  @relation("CategoryTree")
  aliases            CategoryAlias[]
  fields             CategoryField[]
  formSchemaVersions CategoryFormSchemaVersion[]
  listings           Listing[]
  businessProfiles   BusinessProfile[]
  providerProfiles   ProviderProfile[]

  @@unique([parentId, slug])
  @@index([vertical, isActive, sortOrder])
  @@map("categories")
}

model CategoryAlias {
  id              String   @id @default(uuid()) @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  locale          String   @db.VarChar(16)
  value           String   @db.VarChar(120)
  normalizedValue String   @map("normalized_value") @db.VarChar(120)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale, normalizedValue])
  @@index([normalizedValue])
  @@map("category_aliases")
}

model CategoryField {
  id           String   @id @default(uuid()) @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  key          String   @db.VarChar(80)
  labelZhHans  String   @map("label_zh_hans") @db.VarChar(120)
  labelEn      String   @map("label_en") @db.VarChar(120)
  helpText     Json?    @map("help_text")
  fieldType    String   @map("field_type") @db.VarChar(40)
  isRequired   Boolean  @default(false) @map("is_required")
  isFilterable Boolean  @default(false) @map("is_filterable")
  isSearchable Boolean  @default(false) @map("is_searchable")
  visibility   String   @default("PUBLIC") @db.VarChar(24)
  options      Json?
  validation   Json?
  sortOrder    Int      @default(0) @map("sort_order")
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId, sortOrder])
  @@map("category_fields")
}

model CategoryFormSchemaVersion {
  id             String    @id @default(uuid()) @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  version        Int
  revision       Int       @default(1)
  definition     Json
  contentHash    String    @map("content_hash") @db.Char(64)
  basedOnVersion Int?      @map("based_on_version")
  createdById    String?   @map("created_by_id") @db.Uuid
  updatedById    String?   @map("updated_by_id") @db.Uuid
  publishedById  String?   @map("published_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, version])
  @@index([categoryId, publishedAt(sort: Desc)])
  @@map("category_form_schema_versions")
}

model Listing {
  id                String                    @id @default(uuid()) @db.Uuid
  type              ListingType
  ownerId           String                    @map("owner_id") @db.Uuid
  organizationId    String?                   @map("organization_id") @db.Uuid
  categoryId        String                    @map("category_id") @db.Uuid
  formSchemaVersion Int                       @default(1) @map("form_schema_version")
  regionId          String                    @map("region_id") @db.Uuid
  status            ContentStatus             @default(DRAFT)
  moderationStatus  ModerationStatus          @default(NOT_REVIEWED) @map("moderation_status")
  locale            String                    @default("zh-Hans") @db.VarChar(16)
  title             String                    @db.VarChar(120)
  slug              String                    @db.VarChar(160)
  summary           String?                   @db.VarChar(240)
  body              String                    @db.Text
  priceAmount       Decimal?                  @map("price_amount") @db.Decimal(14, 2)
  currency          String                    @default("USD") @db.Char(3)
  priceUnit         PriceUnit?                @map("price_unit")
  contactMode       ContactMode               @default(IN_APP) @map("contact_mode")
  attributes        Json                      @default("{}")
  latitude          Decimal?                  @db.Decimal(9, 6)
  longitude         Decimal?                  @db.Decimal(9, 6)
  geoPoint          Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN ((longitude IS NULL) OR (latitude IS NULL)) THEN NULL::geography\n    ELSE (st_setsrid(st_makepoint((longitude)::double precision, (latitude)::double precision), 4326))::geography\nEND")) @map("geo_point")
  locationPrecision String                    @default("CITY") @map("location_precision") @db.VarChar(24)
  qualityScore      Float                     @default(0) @map("quality_score")
  isFeatured        Boolean                   @default(false) @map("is_featured")
  featuredUntil     DateTime?                 @map("featured_until") @db.Timestamptz(6)
  publishedAt       DateTime?                 @map("published_at") @db.Timestamptz(6)
  expiresAt         DateTime?                 @map("expires_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  version           Int                       @default(1)
  owner             User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  organization      Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  category          Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  region            Region                    @relation(fields: [regionId], references: [id], onDelete: Restrict)
  jobDetail         JobDetail?
  rentalDetail      RentalDetail?
  transferDetail    TransferDetail?
  secondhandDetail  SecondhandDetail?
  serviceDetail     ServiceDetail?
  media             ListingMedia[]
  favorites         Favorite[]
  conversations     Conversation[]

  @@unique([type, slug])
  @@index([type, status, publishedAt(sort: Desc)])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([regionId, status, publishedAt(sort: Desc)])
  @@index([ownerId, status, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([geoPoint], map: "listings_geo_point_gist", type: Gist)
  @@index([type, regionId, publishedAt(sort: Desc)], map: "listings_published_partial", where: raw("((status = 'PUBLISHED'::\"ContentStatus\") AND (deleted_at IS NULL))"))
  @@index([title(ops: raw("gin_trgm_ops"))], map: "listings_title_trgm", type: Gin)
  @@map("listings")
}

