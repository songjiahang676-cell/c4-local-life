# Runtime
NODE_ENV=development
APP_ENV=local
APP_NAME=socal-life-platform
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
API_BASE_URL=http://localhost:4000/v1
# Comma-separated <vertical>:<city-slug> pairs; leave empty until Growth/Ops approves content.
SEO_INDEXABLE_CITY_ROUTES=
PORT=4000
API_BODY_LIMIT_BYTES=1048576
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=4001

# Database
DATABASE_URL=postgresql://socal:socal_dev_password@localhost:5432/socal?schema=public
DATABASE_POOL_MAX=20

# Redis / queues
REDIS_URL=redis://localhost:6379/0
OUTBOX_QUEUE_NAME=platform-events
OUTBOX_BATCH_SIZE=25
LISTING_EXPIRY_BATCH_SIZE=50
LISTING_EXPIRY_POLL_INTERVAL_MS=30000
OUTBOX_LEASE_SECONDS=60
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_RETRY_MAX_SECONDS=900
OUTBOX_MAX_PAYLOAD_BYTES=131072
OUTBOX_JOB_ATTEMPTS=8

# Search
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_PREFIX=socal_local
SEARCH_QUERY_TIMEOUT_MS=1500
SEARCH_PIT_KEEP_ALIVE_SECONDS=120
SEARCH_RECONCILIATION_BATCH_SIZE=100
SEARCH_RECONCILIATION_INTERVAL_MS=300000

# Object storage (local MinIO; replace with S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-west-2
S3_QUARANTINE_BUCKET=socal-media-quarantine-local
S3_MEDIA_BUCKET=socal-media-processed-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000
MEDIA_PROCESS_MAX_BYTES=20971520
MEDIA_IMAGE_MAX_PIXELS=40000000
MEDIA_UPLOAD_URL_TTL_SECONDS=300
MEDIA_UPLOAD_MAX_ACTIVE=20
MEDIA_UPLOAD_DAILY_BYTES=209715200
PUBLIC_MEDIA_BASE_URL=http://localhost:9000/socal-media-local

# Email / SMS adapters
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@socal.local
SMS_PROVIDER=stub
SMS_FROM=

# Auth
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=socal_session
SESSION_ABSOLUTE_TTL_SECONDS=2592000
SESSION_IDLE_TTL_SECONDS=604800
SESSION_TOUCH_INTERVAL_SECONDS=300
CSRF_SECRET=replace-with-another-random-secret
OTP_SECRET=replace-with-a-dedicated-32-byte-otp-secret
MFA_SECRET=replace-with-a-dedicated-32-byte-mfa-encryption-and-hmac-secret
MFA_ENROLLMENT_TTL_SECONDS=600
MFA_MAX_ATTEMPTS=5
MFA_LOCK_SECONDS=300
ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=28800
ADMIN_SESSION_IDLE_TTL_SECONDS=1800
ADMIN_STEP_UP_TTL_SECONDS=600
ORGANIZATION_INVITATION_TTL_SECONDS=259200
PASSWORD_PEPPER=replace-with-a-dedicated-32-byte-password-pepper-secret
PASSWORD_LOGIN_MAX_FAILURES=5
PASSWORD_LOGIN_LOCK_SECONDS=300
PASSWORD_LOGIN_IDENTIFIER_LIMIT=10
PASSWORD_LOGIN_IDENTIFIER_WINDOW_SECONDS=900
PASSWORD_LOGIN_IP_LIMIT=50
PASSWORD_LOGIN_IP_WINDOW_SECONDS=3600
PASSWORD_LOGIN_DEVICE_LIMIT=30
PASSWORD_LOGIN_DEVICE_WINDOW_SECONDS=3600
PASSWORD_RECOVERY_TTL_SECONDS=1800
PASSWORD_RECOVERY_COOLDOWN_SECONDS=300
PASSWORD_RECOVERY_MAX_ATTEMPTS=5
PASSWORD_RECOVERY_DESTINATION_LIMIT=3
PASSWORD_RECOVERY_DESTINATION_WINDOW_SECONDS=3600
PASSWORD_RECOVERY_IP_LIMIT=20
PASSWORD_RECOVERY_IP_WINDOW_SECONDS=3600
PASSWORD_RECOVERY_DEVICE_LIMIT=10
PASSWORD_RECOVERY_DEVICE_WINDOW_SECONDS=3600
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_DESTINATION_LIMIT=3
OTP_DESTINATION_WINDOW_SECONDS=900
OTP_IP_LIMIT=20
OTP_IP_WINDOW_SECONDS=3600
OTP_DEVICE_LIMIT=10
OTP_DEVICE_WINDOW_SECONDS=3600

# Payments (disabled until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=socal-api
OTEL_SERVICE_VERSION=0.1.0
LOG_LEVEL=debug

# Feature flags
FEATURE_PAYMENTS=false
FEATURE_MESSAGING=true
FEATURE_COMMUNITY=false
FEATURE_CROSS_BORDER=false
